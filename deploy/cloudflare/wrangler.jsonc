{
  "$schema": "../../../.local/share/wrangler-cli/node_modules/wrangler/config-schema.json",
  "name": "yantra-sangha",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  // Every request goes through the Worker, so it can check the sangha-word cookie
  // and trim Zazen from the shelf unless the Zazen word was entered.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "r2_buckets": [{ "binding": "AUDIO", "bucket_name": "yantra-sangha-audio" }],
  // Reminders: one anonymous record per device. setup-reminders.sh fills in the id.
  // Practice sync reuses this namespace: practice:d:<lookupId>:<deviceId> holds
  // ciphertext only, practice:gone:<lookupId> forgets a key, practice:rl:<lookupId>
  // is a short-lived rate counter. No new binding and no new secret.
  "kv_namespaces": [{ "binding": "REMINDERS", "id": "4ab84262eaf747d0bb2140c0fff24c8e" }],
  "triggers": { "crons": ["* * * * *"] },
  "workers_dev": true,
  "routes": [
    { "pattern": "yantramedi.app", "custom_domain": true },
    { "pattern": "www.yantramedi.app", "custom_domain": true }
  ],
  "preview_urls": false
  // SANGHA_WORD, ZAZEN_WORD, COOKIE_KEY, VAPID_PUBLIC_KEY and VAPID_PRIVATE_KEY
  // are secrets (wrangler secret put ...), kept out of this public repo.
  // VAPID_PRIVATE_KEY is the JWK JSON. VAPID_PUBLIC_KEY is the raw P-256 key, base64url.
}
